{
  "manifest_version": 2,
  "name": "SocialFilter Facebook",
  "version": "0.1.1",
  "browser_specific_settings": { "gecko": { "id": "facebook@socialfilter.app" } },
  "content_scripts": [{
    "matches": ["https://facebook.com/*", "https://*.facebook.com/*"],
    "js": ["filter.js"],
    "run_at": "document_start",
    "all_frames": false
  }],
  "permissions": ["nativeMessaging", "nativeMessagingFromContent", "geckoViewAddons"]
}
